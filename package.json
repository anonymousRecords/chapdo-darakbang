{
  "name": "ux-interaction-log",
  "private": true,
  "scripts": {
    "build": "pnpm gen:registry && pnpm build:interactions && turbo run build --filter=web",
    "build:interactions": "tsx packages/scripts/build-interactions.ts",
    "dev": "turbo run dev --concurrency=30",
    "dev:gallery": "pnpm dev:web",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "gen:registry": "tsx packages/scripts/gen-registry/index.ts",
    "gallery": "pnpm dev:web",
    "dev:web": "pnpm --filter web dev",
    "new:work": "pnpm --filter web new:work",
    "gen:works": "pnpm --filter web gen:works",
    "test": "pnpm --filter web test"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "turbo": "^2.5.8",
    "typescript": "5.9.2",
    "vite": "^7.1.7"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "esbuild": "^0.25.11"
  }
}
